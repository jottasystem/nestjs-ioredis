{
  "name": "@raphaabreu/nestjs-ioredis",
  "version": "0.2.0",
  "description": "ioredis cluster module for NestJS (Redis / Valkey / ElastiCache)",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rimraf lib",
    "build": "npm run clean && tsc",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint src test",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaabreu/nestjs-ioredis.git"
  },
  "author": "Raphael Lorenzeto de Abreu <raphael.lorenzeto@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/raphaabreu/nestjs-ioredis/issues"
  },
  "homepage": "https://github.com/raphaabreu/nestjs-ioredis#readme",
  "dependencies": {
    "flatted": "^3.4.4"
  },
  "peerDependencies": {
    "@nestjs/common": ">=8.0.1",
    "ioredis": ">=5.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/testing": "^12.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "ioredis": "^6.0.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
